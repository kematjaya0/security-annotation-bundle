        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/security-core": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/browser-kit": "^6.4",
        "symfony/phpunit-bridge": "^6.4",
        "symfony/security-bundle": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\SecurityAnnotationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\SecurityAnnotationBundle\\Tests\\": "tests/"
        }
